[Unit]
Description=Telegram Media Server subscription VPN
Wants=network-online.target
After=network-online.target

[Service]
User=tms-vpn
Group=tms-vpn
ExecStart=/usr/bin/xray run -config /etc/telegram-media-server-vpn/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
# Xray startup diagnostics can contain profile credentials.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
